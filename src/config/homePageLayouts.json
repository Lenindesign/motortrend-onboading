{
  "version": "1.0.0",
  "lastUpdated": "2025-12-18T00:00:00.000Z",
  "components": {
    "TopTenCarousel": {
      "id": "TopTenCarousel",
      "name": "Top Ten Carousel",
      "description": "Top 10 vehicles carousel with optional local listings sidebar",
      "type": "full-width",
      "icon": "view_carousel",
      "props": {
        "initialVehicleType": {
          "type": "select",
          "options": ["SUV", "Sedan", "Truck", "Coupe", "Performance", "Recommended For You"],
          "default": "SUV"
        },
        "initialSubcategory": {
          "type": "select",
          "options": ["All", "Subcompact", "Compact", "Midsize", "Full-Size", "Luxury", "Electric"],
          "default": "All"
        },
        "showLeads": {
          "type": "boolean",
          "default": false,
          "label": "Show Leads Sidebar"
        }
      }
    },
    "VehicleLeadsStripe": {
      "id": "VehicleLeadsStripe",
      "name": "Vehicle Leads Stripe",
      "description": "Available vehicle listings stripe",
      "type": "full-width",
      "icon": "directions_car",
      "props": {}
    },
    "HeroPlusThree": {
      "id": "HeroPlusThree",
      "name": "Hero + 3 Cards",
      "description": "Hero article with 3 vertical cards",
      "type": "two-column",
      "icon": "dashboard",
      "props": {
        "title": {
          "type": "text",
          "default": "Recommended For You"
        },
        "showAd": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "TrendingStories": {
      "id": "TrendingStories",
      "name": "Trending Stories",
      "description": "Trending stories carousel",
      "type": "full-width",
      "icon": "trending_up",
      "props": {
        "moveToTopOnActivity": {
          "type": "boolean",
          "default": false,
          "label": "Move to Top on Activity",
          "description": "When enabled, moves this component to the top of the page when user has enough viewed vehicles"
        },
        "activityThreshold": {
          "type": "number",
          "default": 4,
          "label": "Activity Threshold",
          "description": "Number of viewed vehicles needed to trigger move to top (only applies when Move to Top is enabled)"
        }
      }
    },
    "PersonalizedVehicles": {
      "id": "PersonalizedVehicles",
      "name": "Personalized Vehicles",
      "description": "Viewed, Searched, You Might Like sections",
      "type": "full-width",
      "icon": "person_search",
      "props": {
        "moveToTopOnActivity": {
          "type": "boolean",
          "default": true,
          "label": "Move to Top on Activity",
          "description": "When enabled, moves this component to the top of the page when user has 4+ viewed vehicles"
        },
        "activityThreshold": {
          "type": "number",
          "default": 4,
          "label": "Activity Threshold",
          "description": "Number of viewed vehicles needed to trigger move to top (only applies when Move to Top is enabled)"
        }
      }
    },
    "WhatIsMyCarWorth": {
      "id": "WhatIsMyCarWorth",
      "name": "What Is My Car Worth",
      "description": "Trade-in value calculator",
      "type": "full-width",
      "icon": "price_change",
      "props": {}
    },
    "UserRatingsReviews": {
      "id": "UserRatingsReviews",
      "name": "User Ratings & Reviews",
      "description": "User ratings and reviews section",
      "type": "full-width",
      "icon": "star_rate",
      "props": {}
    },
    "KnowYourBudget": {
      "id": "KnowYourBudget",
      "name": "Know Your Budget",
      "description": "Budget calculator widget",
      "type": "full-width",
      "icon": "savings",
      "props": {}
    },
    "NewsSection": {
      "id": "NewsSection",
      "name": "News Section",
      "description": "News articles list",
      "type": "two-column",
      "icon": "newspaper",
      "props": {
        "title": {
          "type": "text",
          "default": "Latest Car News"
        },
        "maxItems": {
          "type": "number",
          "default": 10,
          "min": 3,
          "max": 20
        },
        "showAd": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "VehiclesSection": {
      "id": "VehiclesSection",
      "name": "Vehicles Section",
      "description": "Vehicle cards grid",
      "type": "two-column",
      "icon": "grid_view",
      "props": {
        "title": {
          "type": "text",
          "default": "Top Ranked Vehicles"
        },
        "showAd": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "CommunityPostsPromo": {
      "id": "CommunityPostsPromo",
      "name": "Community Posts",
      "description": "Trending community posts",
      "type": "two-column",
      "icon": "forum",
      "props": {
        "title": {
          "type": "text",
          "default": "Trending in Community"
        },
        "maxPosts": {
          "type": "number",
          "default": 6,
          "min": 3,
          "max": 12
        },
        "showAd": {
          "type": "boolean",
          "default": true
        }
      }
    }
  },
