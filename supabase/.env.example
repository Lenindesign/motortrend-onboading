# Copy to supabase/.env for local Edge Function testing:
#   cp supabase/.env.example supabase/.env
#
# Then run from repo root:
#   supabase functions serve --env-file supabase/.env
#
# OPENAI_API_KEY is required. Supabase URL/keys are injected when using
# `supabase functions serve` against a linked project; for fully offline
# testing, add SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# from the project API settings (Dashboard → Project Settings → API).

OPENAI_API_KEY=replace-with-your-openai-api-key
