#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🎨 Running design token governance checks..."

# Run CSS token linter
node scripts/lint-css-tokens.js --staged

# If the linter fails, prevent commit
if [ $? -ne 0 ]; then
  echo "❌ Design token violations detected. Please fix before committing."
  exit 1
fi

# Run ESLint on staged files and block only newly introduced errors.
node scripts/lint-staged-eslint.mjs

# If ESLint fails, prevent commit
if [ $? -ne 0 ]; then
  echo "❌ New ESLint errors detected in staged files. Please fix before committing."
  exit 1
fi

echo "✅ All checks passed!"
